{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch yamlizr",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/CasCap.DevOpsYamlizrCli/bin/Debug/net10.0/yamlizr.dll",
            "args": ["${input:commandLine}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "logging": {
                "moduleLoad": false,
                "processExit": false
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ],
    "inputs": [
        {
            "id": "commandLine",
            "type": "promptString",
            "description": "Arguments to pass to the tool, e.g. 'generate --help'",
            "default": "--help"
        }
    ]
}
