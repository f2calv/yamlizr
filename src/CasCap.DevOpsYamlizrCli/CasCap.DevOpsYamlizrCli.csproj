<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>yamlizr</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Azure DevOps Classic-to-YAML Pipelines CLI</Description>
    <PackageTags>azure,devops,classic,yaml,pipelines,cli,codegen</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yamlizr</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Figgle.Fonts" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ShellProgressBar" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="Always" />
    <None Update="appsettings.Local*.json;appsettings.*.Local.json" CopyToPublishDirectory="Never" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasCap.Api.AzureDevOps\CasCap.Api.AzureDevOps.csproj" />
  </ItemGroup>

</Project>
